# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local SQLite databases and backups
/admin_server/data/*.db
/admin_server/data/*.db-*
/admin_server/data/*.sqbpro

# Keep reviewed example database
!/admin_server/data/admin.db.example

# Local HTTPS certificates and private keys
/admin_server/certs/*.key
/admin_server/certs/*.pem
/admin_server/key.pem
/admin_server/cert.pem

# Local credentials
/admin_server/.env
/admin_server/.env.*