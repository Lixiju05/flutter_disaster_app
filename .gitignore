# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local SQLite databases and backups
/admin_server/data/*.db
/admin_server/data/*.db-*
/admin_server/data/*.sqbpro

# Keep reviewed example database
!/admin_server/data/admin.db.example

# Local HTTPS certificates and private keys
/admin_server/certs/*.key
/admin_server/certs/*.pem
/admin_server/key.pem
/admin_server/cert.pem

# Local credentials
/admin_server/.env
/admin_server/.env.*

# Local databases, SQLite sidecars and backup variants (any directory)
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite-*
*.sqlite.*
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.sqbpro
*.bak
*.backup
/admin_server/data/*.zip
/admin_server/data/*.7z
/admin_server/data/*.gz
/admin_server/data/*.tar
.hucares-test-database

# Local secrets; public firebase_options.dart/google-services.json are not keys
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
application_default_credentials.json
credentials.json
adc.json
adc-*.json
*service-account*.json
*service_account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.token
oauth-token*.json

# Preserve explicitly reviewed templates, including admin.db.example/.env.example
!*.example
